{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booking-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  // Free plan: keep usage observable so limits are visible before they bite.
  "observability": { "enabled": true },
  // Nightly sandbox reset at 08:00 UTC (3–4 AM in New York). Uses 1 of the Free plan's 5 Cron Triggers.
  "triggers": { "crons": ["0 8 * * *"] }
}
